APP_NAME=Grocery
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=forge
DB_USERNAME=forge
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── Mail (SMTP) ────────────────────────────────────────────────────────
# Used by Laravel Mailer for OTP emails, welcome emails, and order invoices.
# For Gmail SMTP, generate an App Password at:
#   https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification enabled on your Google account.)
# Do NOT use your normal Gmail password — use the 16-character App Password.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Production Configuration ────────────────────────────────────────────
#
# H5: Secure Session Cookies
# Set to "true" in production to ensure session cookies are only sent over HTTPS.
# Leave as null for local HTTP development.
# SESSION_SECURE_COOKIE=true
#
# M1: Session Encryption
# Set to "true" in production to encrypt all session data at rest.
# Leave as false for local development.
# SESSION_ENCRYPT=true
#
# H6: Sanctum Token Expiration
# Set to a positive integer (minutes) in production to enforce token expiration.
# null = tokens never expire (not recommended for production).
# SANCTUM_EXPIRATION=1440
#
# M11: Database Production Security
# Use a dedicated database user with minimal required privileges in production.
# Do NOT use root credentials. Ensure SSL/TLS is configured for remote databases.
# DB_HOST=your-production-db-host
# DB_DATABASE=your_production_db
# DB_USERNAME=your_app_user
# DB_PASSWORD=your_secure_password
#
# M12: Mail Production Configuration
# Configure SMTP credentials via environment variables.
# Do NOT hardcode SMTP credentials in version control.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.your-provider.com
# MAIL_PORT=587
# MAIL_USERNAME=your_smtp_username
# MAIL_PASSWORD=your_smtp_password
# MAIL_ENCRYPTION=tls
#
# H16: Queue Worker Supervision
# Production requires a process supervisor (e.g., Supervisor, systemd) to keep
# queue workers running. This is an infrastructure/deployment responsibility,
# not an application concern. Example supervisor config:
#
# [program:grocery-worker]
# process_name=%(program_name)s_%(process_num)02d
# command=php artisan queue:work database --sleep=3 --tries=3 --max-time=3600
# autostart=true
# autorestart=true
# stopasgroup=true
# killasgroup=true
# numprocs=2
# redirect_stderr=true
# stdout_logfile=/var/log/grocery-worker.log
#
# H15: Session Cleanup
# Laravel's database session driver automatically cleans expired sessions via
# the built-in lottery GC mechanism (configured in config/session.php).
# No additional scheduled cleanup is required.
#
# Firebase Cloud Messaging (Push Notifications)
# To enable Web Push notifications, create a Firebase project at
# https://console.firebase.google.com and generate a service account key.
# Place the JSON key file outside the web root and set the path below.
# FIREBASE_CREDENTIALS=/path/to/firebase-service-account.json
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_API_KEY=your-firebase-web-api-key
# FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# FIREBASE_MESSAGING_SENDER_ID=your-sender-id
# FIREBASE_APP_ID=your-app-id
# FIREBASE_VAPID_KEY=your-vapid-key
#
# Twilio SMS (Phone MFA / OTP Delivery)
# To enable SMS OTP delivery, create a Twilio account at https://www.twilio.com
# and purchase a phone number capable of sending SMS.
# TWILIO_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+1234567890
#
# Google OAuth (Social Login)
# To enable Google Sign-In, create a project at https://console.cloud.google.com
# and configure OAuth 2.0 credentials.
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=http://localhost/auth/google/callback
